# ---------------------------------------------------------------
# TalentLoom environment variables
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# Then fill in the values. NEVER commit .env.local.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Public URL of the site (no trailing slash)
# Local: http://localhost:3002   Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (starts with sb_publishable_) — or the legacy "anon" key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# SECRET key (starts with sb_secret_) — or the legacy "service_role" key.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never paste into client code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Impersonation (Phase 5) ---
# 32+ random characters. Generate with:  openssl rand -base64 48
IMPERSONATION_COOKIE_SECRET=

# --- Scheduled jobs (Phase 6) ---
# Random string Vercel Cron sends to protect job endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Stripe (Phase 6, TEST MODE keys first: sk_test_ / pk_test_) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional ---
# SENTRY_DSN=
