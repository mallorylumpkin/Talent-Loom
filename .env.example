# ---------------------------------------------------------------
# TalentLoom environment variables
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# Then fill in the values. NEVER commit .env.local.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Public URL of the site (no trailing slash)
# Local: http://localhost:3002   Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (starts with sb_publishable_) — or the legacy "anon" key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# SECRET key (starts with sb_secret_) — or the legacy "service_role" key.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never paste into client code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- "View as user" for support (admin console) ---
# Encrypts the admin's own session while viewing as a user. 32+ random characters, SERVER ONLY.
# Generate with:  openssl rand -base64 48
IMPERSONATION_COOKIE_SECRET=

# --- Scheduled jobs ---
# Random string Vercel Cron sends to protect job endpoints (daily social sync). Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Connected social accounts (see docs/SOCIAL-CONNECTIONS.md) ---
# Encrypts platform tokens before they're stored. SERVER ONLY. Generate with: openssl rand -base64 32
# Never change it after creators connect (they'd all have to reconnect).
TOKEN_ENCRYPTION_KEY=
# YouTube — Google Cloud → APIs & Services → Credentials (OAuth client, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram — Meta for Developers → Instagram → API setup with Instagram business login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook Pages — Meta for Developers → your app → Facebook Login for Business (Meta App ID / App secret)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# TikTok — TikTok for Developers → your app → Login Kit
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Stripe (Phase 6, TEST MODE keys first: sk_test_ / pk_test_) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional ---
# SENTRY_DSN=
